# 本番デプロイ用(docker-compose.prod.yml)の環境変数。
# EC2上で `.env` として配置する（`chmod 600 .env` を忘れずに）。
# DATABASE_URLはdocker-compose.prod.yml側でMYSQL_*から自動的に組み立てられるため、
# ここでは個別の接続情報のみを設定する。

MYSQL_DATABASE=inquiry_management
MYSQL_USER=inquiry_user
MYSQL_PASSWORD=change-me-to-a-strong-password
MYSQL_ROOT_PASSWORD=change-me-to-a-strong-password

# 管理者ページ(/inquiries/admin)のログインに使用するパスワード。推測されにくい値にする。
ADMIN_PASSWORD=change-me-to-a-strong-password

# セッションCookieにSecure属性を付けるかどうか。現状デプロイ先はHTTPS未対応のため
# falseのままにする。HTTPS化した際にtrueへ変更すること(falseのままだとHTTPS環境でも
# Cookieは送信されるが、Secure属性がない分だけ盗聴リスクが残る)。
COOKIE_SECURE=false
